rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.admin == true;
    }

    // ─── Users ───────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Users can update their own profile (including XP via Firestore-direct path)
      // Anti-abuse: users cannot set XP to an arbitrary value — only increment is possible
      // via server-side transactions. Direct write is allowed to support fallback when
      // Cloud Functions are not deployed.
      allow update: if isOwner(userId);
      allow create: if isOwner(userId);

      // Completed contents subcollection — readable by owner
      match /completedContents/{contentId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId); // Written by Firestore transaction (client or CF)
      }
    }

    // ─── Content Sessions ─────────────────────────────────────────────────────
    // Users create their own sessions; Cloud Functions update them.
    match /contentSessions/{sessionId} {
      allow create: if isSignedIn() &&
        request.resource.data.user_uid == request.auth.uid;
      allow read: if isSignedIn() &&
        resource.data.user_uid == request.auth.uid;
      allow update: if false; // Cloud Functions only
      allow delete: if false;
    }

    // ─── Test Attempts ────────────────────────────────────────────────────────
    // Users create their own attempts; Cloud Functions complete them.
    match /testAttempts/{attemptId} {
      allow create: if isSignedIn() &&
        request.resource.data.user_uid == request.auth.uid;
      allow read: if isSignedIn() &&
        resource.data.user_uid == request.auth.uid;
      allow update: if false; // Cloud Functions only
      allow delete: if false;
    }

    // ─── XP History ──────────────────────────────────────────────────────────
    match /xp_history/{entryId} {
      allow read: if isSignedIn() && resource.data.user_uid == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.user_uid == request.auth.uid;
      allow update, delete: if false;
    }

    // ─── Leaderboards ────────────────────────────────────────────────────────
    // Public read (safe — only name, district, xp exposed).
    // Only Cloud Functions write snapshots.
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false; // Cloud Functions only
    }

    // ─── User Progress ───────────────────────────────────────────────────────
    match /userProgress/{userId}/{documents=**} {
      allow read, write: if isOwner(userId);
    }

    // ─── User Last Watched ────────────────────────────────────────────────────
    match /userLastWatched/{userId}/{documents=**} {
      allow read, write: if isOwner(userId);
    }

    // ─── Admins collection ───────────────────────────────────────────────────
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ─── Content (public read, admin write) ───────────────────────────────────
    match /subjects/{subjectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /chapters/{chapterId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /resources/{resourceId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /practiceTests/{testId} {
      allow read: if true;
      allow write: if isAdmin();
      match /questions/{questionId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ─── Q&A ─────────────────────────────────────────────────────────────────
    match /qa/{qaId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.askedBy == request.auth.uid &&
        request.resource.data.question is string &&
        request.resource.data.question.size() > 0 &&
        request.resource.data.question.size() <= 500;
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.askedBy == request.auth.uid);
    }

    // ─── Discussions ──────────────────────────────────────────────────────────
    match /discussions/{discussionId} {
      allow read: if true;
      allow create: if isSignedIn() &&
        request.resource.data.authorUid == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.size() > 0 &&
        request.resource.data.message.size() <= 1000;
      allow delete: if isAdmin() ||
        (isSignedIn() && resource.data.authorUid == request.auth.uid);
    }

    // ─── Default deny ─────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
